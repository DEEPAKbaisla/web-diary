# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (server-only). Use a direct connection for
# migrations and the pooled connection string for runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Better Auth secret. Must be at least 32 characters of high entropy.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-min-32-chars!!"

# Base URL of the application.
BETTER_AUTH_URL="http://localhost:3000"

# Extra trusted origins (comma separated). Add your production + Vercel preview
# origins here. Better Auth uses this to validate request origins (CSRF).
# TRUSTED_ORIGINS="https://your-app.vercel.app,https://*.your-app.vercel.app"

# ---------------------------------------------------------------------------
# Owner account provisioning (used once by `scripts/create-owner.ts`).
# These are read by the setup script only; they are never exposed to the client.
# ---------------------------------------------------------------------------
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-strong-owner-password"

# ---------------------------------------------------------------------------
# Rate limiting (PostgreSQL-backed, shared across serverless instances)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
LOGIN_RATE_LIMIT_MAX="10"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"
TRIP_RATE_LIMIT_MAX="120"
TRIP_RATE_LIMIT_WINDOW_SECONDS="60"

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Maximum fare accepted in INR (non-negative integer).
MAX_FARE_INR="1000000"
