{
  "name": "diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:owner": "tsx scripts/create-owner.ts",
    "db:seed:test": "tsx scripts/seed-test-owner.ts",
    "auth:check": "auth check schema",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.12",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
